# Build/download/test outputs and local projects
/build/
/dist/
/.cache/
/.venv/
/.vs/
/CMakeUserPresets.json
__pycache__/
*.py[cod]
*.exe
*.exe.*
*.dll
*.dll.*
*.lib
*.obj
*.o
*.pdb
*.exp
*.ilk
*.bin
*.rxdata
*.rgssad
*.rxproj
*.rvdata2
*.rgss3a
*.rvproj2
