# User-supplied release template; keep the original RGSS DLL and saves excluded.
!template-xp/Game.exe
!template-xp/Game.rxproj
!template-xp/Data/*.rxdata
!template-xp/Graphics/**/*.png
!template-xp/Graphics/**/*.jpg
!template-xp/Audio/**/*.wav
!template-xp/Audio/**/*.ogg
!template-xp/Audio/**/*.mp3
!template-xp/Audio/**/*.mid

# User-supplied VX Ace project; no original engine, personal saves or logs.
!template-vxa/Game.exe
!template-vxa/Game.rvproj2
!template-vxa/Data/*.rvdata2
!template-vxa/Graphics/**/*.png
!template-vxa/Graphics/**/*.jpg
!template-vxa/Audio/**/*.wav
!template-vxa/Audio/**/*.ogg
!template-vxa/Audio/**/*.mp3
!template-vxa/Audio/**/*.mid
template-vxa/System/
template-vxa/Saves/
